{
 "procedures": {
  "teacherD": {
   "A": "Transposition : on fait passer un terme de l'autre côté du signe « = » en changeant son signe, puis on divise par le coefficient de x.",
   "B": "Dénominateur commun : on réduit au même dénominateur (plus petit multiple commun), on additionne les numérateurs, on simplifie.",
   "D": "Discriminant : on calcule Δ = b² − 4ac, on discute le signe de Δ, on écrit les racines x = (−b ± √Δ) / (2a).",
   "E": "Substitution : (1) on exprime une inconnue en fonction de l'autre ; (2) on la remplace dans l'autre équation ; (3) on résout, puis on revient à l'expression de (1). Variante enseignée : Cramer (déterminants)."
  },
  "teacherN": {
   "A": "On ajoute l'opposé de part et d'autre de l'égalité, puis on divise par le coefficient (programme sénégalais). Modèle : ax+b=c ; ax+b−b=c−b ; ax=c−b ; x=(c−b)÷a. Avec des x des deux côtés : 3x−2=x+5 ; 3x−x−2+2=x−x+5+2 ; 2x=7 ; x=7÷2.",
   "B": "Dénominateur commun : on réduit au même dénominateur (plus petit multiple commun), on additionne les numérateurs, on simplifie. Un entier s'écrit d'abord comme une fraction de dénominateur 1 (2 = 2/1) ; le préciser aux élèves.",
   "C": "Coefficient de linéarité : on détermine a = f(x)/x, puis on calcule f(x') = a·x'.",
   "D": "Discriminant : on calcule Δ = b² − 4ac, on discute le signe de Δ, on écrit les racines x = (−b ± √Δ) / (2a). Préciser que si Δ<0, l'équation n'admet pas de solution dans IR.",
   "E": "Substitution : (1) on exprime une inconnue en fonction de l'autre ; (2) on la remplace dans l'autre équation ; (3) on résout, puis on revient à l'expression de (1). Variante enseignée : Cramer (déterminants)."
  },
  "teacherNd": {
   "A": "Transposition : on fait passer un terme de l'autre côté du signe « = » en changeant son signe, puis on divise par le coefficient de x.",
   "B": "Dénominateur commun : on réduit au même dénominateur (plus petit multiple commun), on additionne les numérateurs, on simplifie.",
   "C": "Coefficient de linéarité : on détermine a = f(x)/x, puis on calcule f(x') = a·x'.",
   "D": "Discriminant : on calcule Δ = b² − 4ac, on discute le signe de Δ, on écrit les racines x = (−b ± √Δ) / (2a).",
   "E": "Substitution : (1) on exprime une inconnue en fonction de l'autre ; (2) on la remplace dans l'autre équation ; (3) on résout, puis on revient à l'expression de (1). Variante enseignée : Cramer (déterminants)."
  }
 },
